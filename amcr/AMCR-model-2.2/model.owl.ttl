:ext_zdroj a owl:Class, rdfs:Class;
    rdfs:label "Externí zdroj (ext_zdroj)"@cs, "External Source (ext_zdroj)"@en;
    rdfs:comment "Bibliografický segment AMČR slouží k napojení archeologických záznamů na zdrojové informace v publikacích, odborných zprávách a šedé literatuře. Jako externí zdroje jsou chápány publikace, novinové články, nepublikované odborné zprávy a jiné informační zdroje, které nejsou uloženy v archivech ARÚ a ARÚB a nejsou tudíž zahrnuty mezi dokumenty. Pomocí externích odkazů jsou tyto provázány s akcemi a lokalitami."@cs, "The AMCR bibliographic segment is used to link archaeological records to source information in publications, expert reports, and grey literature. External sources are understood to be publications, newspaper articles, unpublished reports, and other information sources that are not stored in the ARÚ and ARÚB archives and are therefore not included among the documents. These are linked to fieldwork events and sites by external links."@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>.
<https://amcr.aiscr.cz/schema#ext_zdroj.isbn> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "ISBN"@cs, "ISBN"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain :ext_zdroj;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
<https://amcr.aiscr.cz/schema#ext_zdroj.nazev> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "Název"@cs, "Title"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain :ext_zdroj;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
