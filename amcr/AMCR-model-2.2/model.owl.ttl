    rdfs:range :ruian_katastr.
<https://amcr.aiscr.cz/schema#archeologicky_zaznam.uzivatelske_oznaceni> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "Uživatelské označení"@cs, "User label"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain <https://amcr.aiscr.cz/schema#chranene_udaje.archeologicky_zaznam>;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
<https://amcr.aiscr.cz/schema#archeologicky_zaznam.dalsi_katastr> a rdf:Property, owl:ObjectProperty;
    rdfs:label "archeologický záznam - další katastr"@cs, "archaeological record - other cadastral area"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/spatial>;
    rdfs:domain <https://amcr.aiscr.cz/schema#chranene_udaje.archeologicky_zaznam>;
