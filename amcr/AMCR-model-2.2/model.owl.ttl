    rdfs:subPropertyOf <http://purl.org/dc/terms/subject>;
    rdfs:domain :nalez_predmet;
    rdfs:range :predmet_druh.
<https://amcr.aiscr.cz/schema#nalez_predmet.specifikace> a rdf:Property, owl:ObjectProperty;
    rdfs:label "předmět - materiál"@cs, "object - material"@en;
