    rdfs:label "archeologický dokumentační bod - podnět"@cs, "archaeological documentation point - intervention motivation"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/subject>;
    rdfs:domain :adb;
    rdfs:range :adb_podnet.
<https://amcr.aiscr.cz/schema#adb.autor_popisu> a rdf:Property, owl:ObjectProperty;
    rdfs:label "archeologický dokumentační bod - autor popisu"@cs, "archaeological documentation point - author of description"@en;
