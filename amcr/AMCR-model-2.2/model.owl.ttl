    rdfs:subPropertyOf <http://purl.org/dc/terms/subject>;
    rdfs:domain :nalez_predmet;
    rdfs:range :predmet_specifikace.
<https://amcr.aiscr.cz/schema#nalez_predmet.pocet> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "Počet"@cs, "Count"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain :nalez_predmet;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
<https://amcr.aiscr.cz/schema#nalez_predmet.poznamka> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "Poznámka"@cs, "Note"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain :nalez_predmet;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
<https://amcr.aiscr.cz/schema#nalez_predmet.id> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "ID"@cs, "ID"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain :nalez_predmet;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
