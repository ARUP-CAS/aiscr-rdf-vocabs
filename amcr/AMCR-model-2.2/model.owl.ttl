<https://amcr.aiscr.cz/schema#archeologicky_zaznam.hlavni_katastr> a rdf:Property, owl:ObjectProperty;
    rdfs:label "archeologický záznam - hlavní katastr"@cs, "archaeological record - main cadastral area"@en;
