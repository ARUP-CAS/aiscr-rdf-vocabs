@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix prof: <http://www.w3.org/ns/dx/prof/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix : <https://amcr.aiscr.cz/schema#>.

<https://amcr.aiscr.cz/schema#> a owl:Ontology, prof:Profile.
:jazyk a owl:Class, rdfs:Class;
    rdfs:label "Jazyk (jazyk)"@cs, "Language (jazyk)"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subClassOf :heslo.
:chranene_udaje a owl:Class, rdfs:Class;
    rdfs:label "Chráněné údaje (chranene_udaje)"@cs, "Protected Data (chranene_udaje)"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>.
:lokalita a owl:Class, rdfs:Class;
    rdfs:label "Lokalita (lokalita)"@cs, "Site (lokalita)"@en;
    rdfs:comment "Lokalita je soubor archeologických nálezů a pozorování odpovídající určitému místu (prostorovému vymezení), charakteristickému archeologickému projevu a předpokládané funkční souvislosti v minulosti. Pro vymezení „lokality“ je rozhodující forma archeologického záznamu (projevu). Lokalita má právě jednu dokumentační jednotku. Komponenta lokality je prostorovým, chronologickým a funkčním celkem nálezů z jedné lokality."@cs, "A site is a collection of archaeological finds and observations corresponding to a specific location (spatial delineation), characteristic archaeological manifestation, and presumed past functional context. For defining a 'site', the form of the archaeological record (manifestation) is crucial. A site has just one documentation unit. A site component is the spatial, chronological, and functional sum of findings from a site."@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subClassOf :archeologicky_zaznam.
<https://amcr.aiscr.cz/schema#lokalita.igsn> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "IGSN"@cs, "IGSN"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:domain :lokalita;
    rdfs:range <http://www.w3.org/2001/XMLSchema#string>.
<https://amcr.aiscr.cz/schema#lokalita.chranene_udaje> a rdf:Property, owl:ObjectProperty;
    rdfs:label "lokalita - chráněné údaje"@cs, "site - protected data"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/hasPart>;
    rdfs:domain :lokalita;
    rdfs:range <https://amcr.aiscr.cz/schema#chranene_udaje.lokalita>.
<https://amcr.aiscr.cz/schema#lokalita.jistota> a rdf:Property, owl:ObjectProperty;
    rdfs:label "lokalita - jistota"@cs, "site - level of confidence"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/type>;
    rdfs:domain :lokalita;
    rdfs:range :jistota_urceni.
<https://amcr.aiscr.cz/schema#lokalita.typ_lokality> a rdf:Property, owl:ObjectProperty;
    rdfs:label "lokalita - typ"@cs, "site - type"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/type>;
    rdfs:domain :lokalita;
    rdfs:range :lokalita_typ.
<https://amcr.aiscr.cz/schema#lokalita.zachovalost> a rdf:Property, owl:ObjectProperty;
    rdfs:label "lokalita - zachovalost"@cs, "site - state of preservation"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/type>;
    rdfs:domain :lokalita;
    rdfs:range :stav_dochovani.
<https://amcr.aiscr.cz/schema#lokalita.druh> a rdf:Property, owl:ObjectProperty;
    rdfs:label "lokalita - druh"@cs, "site - class"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf <http://purl.org/dc/terms/subject>;
    rdfs:domain :lokalita;
    rdfs:range :lokalita_druh.
:objekt_druh_kat a owl:Class, rdfs:Class;
    rdfs:label "Kategorie objektu (objekt_druh_kat)"@cs, "Feature Category (objekt_druh_kat)"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subClassOf :heslo.
:nalez_predmet a owl:Class, rdfs:Class;
    rdfs:label "Předmět (nalez_predmet)"@cs, "Object (nalez_predmet)"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subClassOf :nalez.
<https://amcr.aiscr.cz/schema#nalez_predmet.druh> a rdf:Property, owl:ObjectProperty;
    rdfs:label "předmět - druh"@cs, "object - type"@en;
