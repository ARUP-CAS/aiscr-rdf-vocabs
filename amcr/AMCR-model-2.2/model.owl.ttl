    rdfs:range :osoba.
<https://amcr.aiscr.cz/schema#adb.ident_cely> a rdf:Property, owl:DatatypeProperty;
    rdfs:label "ID"@cs, "ID"@en;
    rdfs:isDefinedBy <https://amcr.aiscr.cz/schema#>;
    rdfs:subPropertyOf :ident_cely;
